{
    "openapi": "3.0.3",
    "info": {
      "title": "Toll Station Management API",
      "description": "API documentation for managing toll stations and passes.",
      "version": "1.0.0"
    },
    "paths": {
      "/admin/resetstations": {
        "post": {
          "summary": "Reset Toll Stations",
          "description": "Resets the toll station table using the data provided in the `tollstations2024.csv` file.",
          "responses": {
            "200": {
              "description": "Successful reset",
              "content": {
                "application/json": {
                  "example": {
                    "status": "OK"
                  }
                }
              }
            },
            "500": {
              "description": "Failed reset",
              "content": {
                "application/json": {
                  "example": {
                    "status": "failed",
                    "info": "reason for failure"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  